DATABASE_URL=postgresql://investbest:investbest@localhost:5433/investbest
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
OPENAI_API_KEY=
# Used for dashboard portfolio Q&A and other OpenAI features (defaults to gpt-4o-mini).
OPENAI_MODEL=gpt-4o-mini
TWELVE_DATA_API_KEY=
# Default 7500ms between calls when API key set (free tier). Set 0 to disable pacing.
TWELVE_DATA_MIN_GAP_MS=
# Default 28 symbols per run (holdings first). Set 0 for full tradable universe (needs API headroom).
INVESTBEST_MAX_UNIVERSE_SYMBOLS=
USE_MOCK_MARKET_DATA=true
FINNHUB_API_KEY=
TRIGGER_SECRET_KEY=
TRIGGER_PROJECT_ID=
ML_SERVICE_URL=http://localhost:8088
APP_BASE_URL=http://localhost:3000
INVESTBEST_DEMO_EMAIL=demo@investbest.local
INVESTBEST_INTERNAL_SECRET=change-me-in-production
CRON_SECRET=
# --- Agent Scheduler (Strategy Upgrade §10) ---------------------------------
# Shared secret for /api/internal/scheduler-tick + /api/internal/hourly-run.
# Falls back to INVESTBEST_INTERNAL_SECRET / CRON_SECRET / TRIGGER_SECRET_KEY.
INTERNAL_CRON_SECRET=
# Active SchedulerProvider name: database | triggerdev | vercel-cron (default: database).
SCHEDULER_PROVIDER=database
# Default cadence used when seeding a fresh AgentScheduleSettings row.
DEFAULT_AGENT_RUN_FREQUENCY_MINUTES=60
# How long the per-user agent run lock is held before it auto-expires.
AGENT_RUN_LOCK_TIMEOUT_MINUTES=30
# Master toggle for newly-seeded users (existing users keep their stored value).
ENABLE_AGENT_SCHEDULER=true
# Default schedule "runOnlyDuringMarketHours" toggle for new users only.
ENABLE_MARKET_HOURS_ONLY=false
# Display timezone shown in Settings → Agent Automation (UI only today).
DEFAULT_SCHEDULE_TIMEZONE=America/Denver
