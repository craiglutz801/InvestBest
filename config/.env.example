# InvestBest — copy to .env and fill in values
# See config/SERVICES_CHECKLIST.md for where to get each key.

# App
ENV=development
DEBUG=1
SECRET_KEY=change-me-in-production

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/investbest

# Redis (for Celery and cache)
REDIS_URL=redis://localhost:6379/0

# Data providers
POLYGON_API_KEY=
ALPHA_VANTAGE_API_KEY=
FRED_API_KEY=

# Broker (paper/live)
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# AI / research
OPENAI_API_KEY=

# Notifications (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SLACK_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
