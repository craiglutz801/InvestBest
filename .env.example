# Copy to apps/web/.env for local development
DATABASE_URL=postgresql://investbest:investbest@localhost:5433/investbest
# Fail-closed capability boundary. Only "paper" is accepted; missing/live/other values cannot run the agent.
EXECUTION_MODE=paper
# Emergency kill switch (optional). true/1/on blocks new runs without deleting history.
AGENT_PAUSE=
AGENT_KILL_SWITCH=
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
TWELVE_DATA_API_KEY=
USE_MOCK_MARKET_DATA=true
FINNHUB_API_KEY=
TRIGGER_SECRET_KEY=
TRIGGER_PROJECT_ID=
ML_SERVICE_URL=http://localhost:8088
APP_BASE_URL=http://localhost:3000
INVESTBEST_DEMO_EMAIL=demo@investbest.local
INVESTBEST_INTERNAL_SECRET=change-me-in-production
CRON_SECRET=
